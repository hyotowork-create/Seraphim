import { buildFfmpegArgs, parseFfmpegStats, explainFfmpegError, joinStreamUrl, maskSecret, teeEscape, streamViewState, clampCameraView, cameraTransformCss, DEFAULT_STREAM_CONFIG, QUALITY_PRESETS, emptyCameraSlots, normalizeCameraSlots, resolveCameraLayers, applyCameraPatch, recordBytesPerSec, recordSecondsLeft, diskLevel, formatRecordLeft, formatBytes, DISK_STOP_BYTES } from '../src/shared/stream.ts'
import { DEFAULT_LIVE_STATE } from '../src/shared/ipc.ts'
let fail = 0
const check = (ok: boolean, label: string, extra = '') => { console.log(`[${ok ? 'PASS' : 'FAIL'}] ${label}${extra ? ' — ' + extra : ''}`); if (!ok) fail++ }
const base = { width: 1280, height: 720, fps: 30, videoKbps: 3500, audioKbps: 128, tlsVerify: true }
const url = joinStreamUrl('rtmps://a.rtmps.youtube.com/live2/', ' abcd-efgh-ijkl ')
check(url === 'rtmps://a.rtmps.youtube.com/live2/abcd-efgh-ijkl', '서버 주소 + 키 결합(슬래시·공백 정리)', url)
const live = buildFfmpegArgs({ ...base, encoder: 'h264_videotoolbox', rtmpUrl: url, recordPath: null, vtConstantBitRate: true })
const j = live.join(' ')
check(j.includes('-f matroska -i pipe:0') && j.includes('-map 0:v:0 -map 0:a:0'), '입력: stdin Matroska, 영상·소리 매핑')
check(j.includes('fps=30,scale=1280:720:force_original_aspect_ratio=decrease,pad=1280:720') && j.includes('format=nv12'), '고정 30fps + 1280×720 맞춤 (VideoToolbox는 nv12)')
check(j.includes('-c:v h264_videotoolbox') && j.includes('-b:v 3500k -constant_bit_rate 1') && j.includes('-g 60'), 'VideoToolbox 고정 비트레이트 3.5Mbps, 키프레임 2초')
check(!j.includes('-maxrate') && !j.includes('-bufsize'), 'VideoToolbox에는 -maxrate/-bufsize를 주지 않음 (주면 목표의 약 70%로 낮게 나옴)')
const vtOld = buildFfmpegArgs({ ...base, encoder: 'h264_videotoolbox', rtmpUrl: url, recordPath: null, vtConstantBitRate: false }).join(' ')
check(vtOld.includes('-b:v 3500k') && !vtOld.includes('constant_bit_rate') && !vtOld.includes('-maxrate'), 'macOS 12 이하: 평균 비트레이트만')
const q1440 = QUALITY_PRESETS['1440p']
const a1440 = buildFfmpegArgs({ width: q1440.width, height: q1440.height, fps: q1440.fps, videoKbps: q1440.videoKbps, audioKbps: q1440.audioKbps, encoder: 'h264_videotoolbox', rtmpUrl: url, recordPath: null, tlsVerify: true, vtConstantBitRate: true }).join(' ')
check(a1440.includes('scale=2560:1440') && a1440.includes('-b:v 12000k -constant_bit_rate 1') && a1440.includes('-b:a 160k'), '1440p: 2560×1440, 12 Mbps 고정, AAC 160k')
check(q1440.videoKbps >= 7000 && q1440.camera.width === 3840 && QUALITY_PRESETS['720p'].camera.width === 1920, '1440p는 YouTube H.264 최소(7 Mbps) 이상, 카메라는 한 단계 크게 요청')
check(j.includes('-c:a aac -b:a 128k -ar 48000 -ac 2'), 'AAC 128k 48kHz 스테레오')
check(j.includes('-tls_verify 1 -f flv -flvflags no_duration_filesize') && live[live.length - 1] === url, 'RTMPS: 인증서 검증 + FLV, 마지막 인자가 주소')
const x264 = buildFfmpegArgs({ ...base, encoder: 'libx264', rtmpUrl: 'rtmp://a.rtmp.youtube.com/live2/k', recordPath: null, tlsVerify: true }).join(' ')
check(x264.includes('-preset veryfast -tune zerolatency') && x264.includes('-keyint_min 60 -sc_threshold 0') && x264.includes('nal-hrd=cbr') && x264.includes('format=yuv420p'), 'libx264: 저지연 CBR, 키프레임 고정')
check(!x264.includes('tls_verify'), 'rtmp:// 에는 tls_verify 없음')
const rec = buildFfmpegArgs({ ...base, encoder: 'libx264', rtmpUrl: null, recordPath: '/Users/a/Movies/Seraphim/x.mp4' })
check(rec.join(' ').includes('-f mp4 -movflags +frag_keyframe+empty_moov+default_base_moof') && rec[rec.length - 1] === '/Users/a/Movies/Seraphim/x.mp4', '녹화만: 조각 MP4 (중간에 꺼져도 재생 가능)')
const both = buildFfmpegArgs({ ...base, encoder: 'h264_videotoolbox', rtmpUrl: url, recordPath: "/Users/a/Movies/Seraphim/주일 예배 [1부].mp4" })
const tee = both[both.length - 1]
check(both.includes('tee') && tee.startsWith('[f=flv:flvflags=no_duration_filesize:tls_verify=1:onfail=abort]rtmps://') && tee.includes('|[f=mp4:movflags=+frag_keyframe+empty_moov+default_base_moof:onfail=ignore]'), '방송+녹화: tee (방송 실패는 중단, 녹화 실패는 무시)', tee)
check(tee.endsWith('주일 예배 \\[1부\\].mp4'), 'tee 경로 특수문자 이스케이프', tee)
check(teeEscape("C:\\a|b'c") === "C:\\\\a\\|b\\'c", 'teeEscape: \\ | \' 이스케이프')
let threw = false; try { buildFfmpegArgs({ ...base, encoder: 'libx264', rtmpUrl: null, recordPath: null }) } catch { threw = true }
check(threw, '방송·녹화 둘 다 없으면 오류')
const st = parseFfmpegStats('frame=  301 fps= 29.9 q=21.0 size=    1024KiB time=00:00:10.00 bitrate=3512.4kbits/s speed=1.00x    ')
check(!!st && st.frame === 301 && st.fps === 29.9 && st.kbps === 3512.4 && st.speed === 1, 'ffmpeg 통계 줄 해석', JSON.stringify(st))
check(parseFfmpegStats('[flv @ 0x1] Failed to update header') === null, '통계 아닌 줄은 null')
check(maskSecret('Error opening rtmps://x/live2/abcd-efgh', 'abcd-efgh') === 'Error opening rtmps://x/live2/****', '오류 메시지에서 스트림 키 가림')
check(/연결하지 못했습니다/.test(explainFfmpegError(['[tcp @ 0x] Connection refused'])), '오류 설명: 연결 거부')
check(/스트림 키/.test(explainFfmpegError(['[rtmps @ 0x] Cannot read RTMP handshake response'])), '오류 설명: 핸드셰이크 → 스트림 키 확인')
check(/보안 연결/.test(explainFfmpegError(['[tls @ 0x] Unable to negotiate TLS/SSL session: -9807'])), '오류 설명: TLS')
check(/끊겼/.test(explainFfmpegError(['av_interleaved_write_frame(): Broken pipe'])), '오류 설명: 연결 끊김')
// 방송 화면 파생 (카메라 1·2·3)
const slots = emptyCameraSlots(); slots[0] = { ...slots[0], deviceId: 'iphone', label: 'iPhone' }; slots[1] = { ...slots[1], deviceId: 'osmo', label: 'Osmo Pocket 3' }
const liveState = { ...DEFAULT_LIVE_STATE, text: '주 하나님 지으신 모든 세계', aspect: '4:3' as const, background: { kind: 'color' as const, color: '#112233', dim: 0.3 }, cameras: slots, activeCamera: 1 }
const mirror = streamViewState({ ...liveState, blackout: true }, { ...DEFAULT_STREAM_CONFIG, layout: 'mirror' })
check(mirror.aspect === 'fill' && mirror.blackout === true && mirror.text === liveState.text, 'mirror: 송출 그대로(검정 포함), 16:9 채우기')
const lt = streamViewState(liveState, { ...DEFAULT_STREAM_CONFIG, layout: 'lowerThird', cameraSource: 'program', lowerThirdScale: 0.5 })
check(lt.background.kind === 'camera' && lt.background.cameraSource === 'program' && lt.background.dim === 0, 'lowerThird: 카메라 전환 따라가기 배경(어둡게 없음)')
check(lt.overlay.vAlign === 'bottom' && lt.overlay.fontSize === 36 && lt.text === liveState.text, 'lowerThird: 하단 정렬, 글자 크기 × 배율', `${lt.overlay.fontSize}`)
const ltFixed = streamViewState(liveState, { ...DEFAULT_STREAM_CONFIG, layout: 'lowerThird', cameraSource: 0 })
check(ltFixed.background.kind === 'camera' && ltFixed.background.cameraSource === 0, 'lowerThird: 카메라 1 고정')
const ltEmptySlot = streamViewState(liveState, { ...DEFAULT_STREAM_CONFIG, layout: 'lowerThird', cameraSource: 2 })
check(ltEmptySlot.background.kind === 'color', 'lowerThird: 고정한 카메라가 비어 있으면 송출 배경 유지')
const ltBlack = streamViewState({ ...liveState, blackout: true }, { ...DEFAULT_STREAM_CONFIG, layout: 'lowerThird', cameraSource: 'program' })
check(ltBlack.blackout === false && ltBlack.text === '' && ltBlack.background.kind === 'camera', 'lowerThird: 검정 화면이면 자막만 숨기고 카메라 유지')
const ltNone = streamViewState({ ...liveState, showLogo: true }, { ...DEFAULT_STREAM_CONFIG, layout: 'lowerThird', cameraSource: 'none' })
check(ltNone.showLogo === false && ltNone.text === '' && ltNone.background.kind === 'color', 'lowerThird(카메라 없이): 송출 배경 유지, 로고 대신 자막 숨김')
const ltNoCams = streamViewState({ ...liveState, cameras: emptyCameraSlots() }, { ...DEFAULT_STREAM_CONFIG, layout: 'lowerThird', cameraSource: 'program' })
check(ltNoCams.background.kind === 'color', 'lowerThird: 연결된 카메라가 하나도 없으면 송출 배경 유지')
// 카메라 1·2·3 겹쳐 두기
const rl = resolveCameraLayers(slots, 1, 'program')
check(rl.layers.map((l) => l.index).join(',') === '0,1' && rl.visible === 1, '전환 따라가기: 연결된 카메라 모두 켜 두고 전환된 카메라(2) 보임', JSON.stringify(rl.visible))
check(resolveCameraLayers(slots, 2, 'program').visible === 0, '전환된 칸이 비어 있으면 첫 연결 카메라')
const rf = resolveCameraLayers(slots, 1, 0)
check(rf.layers.length === 1 && rf.visible === 0, '카메라 1 고정: 그 카메라만')
check(resolveCameraLayers(emptyCameraSlots(), 0, 'program').visible === null, '연결된 카메라 없음')
// 카메라 패치
let cs = applyCameraPatch(slots, 0, { activeCamera: 1 })
check(cs.activeCamera === 1, '전환: activeCamera')
check(applyCameraPatch(slots, 0, { activeCamera: 7 }).activeCamera === 0, '범위 밖 전환은 무시')
cs = applyCameraPatch(cs.cameras, cs.activeCamera, { camera: { zoom: 2 } })
check(cs.cameras[1].view.zoom === 2 && cs.cameras[0].view.zoom === 1, '카메라별 줌: + 는 보이는 카메라(2)에만', JSON.stringify(cs.cameras.map((c) => c.view.zoom)))
cs = applyCameraPatch(cs.cameras, cs.activeCamera, { cameraSlot: { index: 0, view: { zoom: 3, x: 0.2 } } })
check(cs.cameras[0].view.zoom === 3 && cs.cameras[0].view.x === 0.2 && cs.cameras[1].view.zoom === 2, '카메라 1 줌을 따로 설정')
cs = applyCameraPatch(cs.cameras, cs.activeCamera, { cameraSlot: { index: 2, deviceId: 'usb', label: 'USB 캠' } })
check(cs.cameras[2].deviceId === 'usb' && cs.cameras[2].label === 'USB 캠', '카메라 3 연결')
cs = applyCameraPatch(cs.cameras, cs.activeCamera, { cameraSlot: { index: 0, deviceId: null } })
check(cs.cameras[0].deviceId === null && cs.cameras[0].view.zoom === 1, '칸 비우면 줌도 초기화')
check(normalizeCameraSlots([{ deviceId: 'a', view: { zoom: 9 } }, 'junk']).map((c) => [c.deviceId, c.view.zoom]).join('|') === 'a,4|,1|,1', '저장값 정리 (3칸, 줌 제한)', JSON.stringify(normalizeCameraSlots([{ deviceId: 'a', view: { zoom: 9 } }])))
// 카메라 줌
check(JSON.stringify(clampCameraView({ zoom: 9, x: -1, y: 2 })) === JSON.stringify({ zoom: 4, x: 0, y: 1 }), '줌·위치 범위 제한 (1~4×, 0~1)')
check(clampCameraView({ zoom: 0.2 }).zoom === 1 && clampCameraView({ zoom: 2.345 }).zoom === 2.35, '줌 하한 1×, 소수 둘째 자리')
const css = cameraTransformCss({ zoom: 2, x: 0.25, y: 0.75 })
check(css.transform === 'scale(2)' && css.transformOrigin === '25.0% 75.0%', '디지털 줌 CSS (중심점 기준 확대)', JSON.stringify(css))
check(QUALITY_PRESETS['720p'].width === 1280 && QUALITY_PRESETS['1080p'].height === 1080 && DEFAULT_STREAM_CONFIG.serverUrl.startsWith('rtmps://a.rtmps.youtube.com'), '기본값: 720p, YouTube RTMPS')
check(DEFAULT_STREAM_CONFIG.recordWithLive === true && !('target' in DEFAULT_STREAM_CONFIG), '기본값: 방송할 때 녹화도 함께')
// 녹화 저장 공간
const GB = 1024 ** 3
const perHour720 = (recordBytesPerSec('720p') * 3600) / GB
const perHour1440 = (recordBytesPerSec('1440p') * 3600) / GB
check(perHour720 > 1.5 && perHour720 < 1.7 && perHour1440 > 5.2 && perHour1440 < 5.4, '녹화 1시간 용량: 720p 약 1.6GB · 1440p 약 5.3GB', `${perHour720.toFixed(2)} / ${perHour1440.toFixed(2)}`)
const left100 = recordSecondsLeft(100 * GB, '720p')
check(Math.abs(left100 / 3600 - (100 - 0.5) / perHour720) < 0.05, '남은 시간 = (남은 공간 − 자동 정지 여유 512MB) ÷ 1초 용량', (left100 / 3600).toFixed(2) + '시간')
check(recordSecondsLeft(DISK_STOP_BYTES - 1, '720p') === 0 && recordSecondsLeft(0, '1440p') === 0, '여유분보다 적으면 0')
check(diskLevel(3600) === 'ok' && diskLevel(1799) === 'low' && diskLevel(599) === 'critical', '경고 단계: 30분·10분')
check(formatRecordLeft(30) === '1분 미만' && formatRecordLeft(45 * 60) === '약 45분' && formatRecordLeft(3 * 3600 + 20 * 60) === '약 3시간 20분' && formatRecordLeft(2 * 3600) === '약 2시간' && formatRecordLeft(200 * 3600) === '100시간 이상', '남은 시간 문구', formatRecordLeft(3 * 3600 + 20 * 60))
check(formatBytes(120 * GB) === '120 GB' && formatBytes(1.5 * GB) === '1.5 GB' && formatBytes(300 * 1024 ** 2) === '300 MB', '용량 문구')
console.log(fail === 0 ? 'STREAM TESTS PASS' : `${fail} FAILED`)
