# FaithOps AI Studio - 환경변수 예시
# 실제 값은 .env.local 에 작성하세요 (.env.local 은 git 에 커밋되지 않습니다)

# AI Provider 선택: mock | (추후) openai | claude | gemini
AI_PROVIDER=mock

# 실제 모델 연동 시 사용할 API 키 (1차 MVP 에서는 비워둬도 됩니다)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Slack Incoming Webhook URL (Slack 일일보고 실제 전송용, 선택)
SLACK_WEBHOOK_URL=
