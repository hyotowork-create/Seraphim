# 이 파일을 .env 로 복사한 뒤 실제 값으로 채우세요. (.env 는 git 에 커밋하지 마세요)
# 주보·PPT 기능은 아래 값이 없어도 동작합니다. 설교 영상 기능에만 필요합니다.

# ── 하이라이트/요약 LLM (둘 중 하나 이상 필요) ───────────────────────
# 하이라이트 분석·요약 제공자: gemini | openai
LLM_PROVIDER=gemini

# Gemini API 키 (Google AI Studio 발급)
GEMINI_API_KEY=
# 무료 사용은 gemini-2.5-flash 권장 (1M 컨텍스트로 긴 설교도 1회 처리)
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API 키 (Gemini 미사용 시 또는 CLOUD STT 사용 시)
OPENAI_API_KEY=
OPENAI_MAP_MODEL=gpt-4o-mini
OPENAI_MODEL=gpt-4o

# ── STT(자막 추출) ──────────────────────────────────────────────────
# 로컬 faster-whisper 기본 모델. device: cpu | cuda(NVIDIA)
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── Slack 진행 알림 (선택) ──────────────────────────────────────────
# 비우면 화면 로그만 사용. 채우면 처리 진행상황을 Slack 스레드로도 전송.
SLACK_BOT_TOKEN=

# ── 쇼츠 자막 폰트 (선택) ───────────────────────────────────────────
# 한글 렌더링 가능한 시스템 폰트명. Windows 기본은 맑은 고딕.
SUB_FONT=Malgun Gothic
