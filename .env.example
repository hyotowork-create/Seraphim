# FaithOps AI Studio - 환경변수 예시
# 실제 값은 .env.local 에 작성하세요 (.env.local 은 git 에 커밋되지 않습니다)

# AI Provider 선택
#  - 비워두면: ANTHROPIC_API_KEY 가 있으면 claude, 없으면 mock 으로 자동 선택
#  - claude : 실제 Claude(Opus 4.8) 연동 (ANTHROPIC_API_KEY 필요)
#  - mock   : API 없이 데모용 더미 생성
AI_PROVIDER=

# 실제 모델 연동 API 키.
# ANTHROPIC_API_KEY 만 채우면 실제 Claude 로 산출물이 생성됩니다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Slack Incoming Webhook URL (Slack 일일보고 실제 전송용, 선택)
SLACK_WEBHOOK_URL=
